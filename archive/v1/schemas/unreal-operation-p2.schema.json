{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-animation-studio.invalid/schemas/unreal-operation-p2.schema.json",
  "title": "AI Animation Studio Unreal episode operation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "episode_id", "episode_code", "master_path", "world_path", "fps", "shots", "input_hash", "operation_id"],
  "properties": {
    "schema_version": {"const": "p2.operation.1"},
    "project_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "episode_code": {"type": "string", "pattern": "^EP[0-9]{2}$"},
    "master_path": {"type": "string", "pattern": "^/Game/"},
    "world_path": {"type": "string", "pattern": "^/Game/"},
    "target_project": {"type": "string", "minLength": 1},
    "fps": {"type": "object", "additionalProperties": false, "required": ["num", "den"], "properties": {"num": {"type": "integer", "minimum": 1}, "den": {"type": "integer", "minimum": 1}}},
    "shots": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/shot"}},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "operation_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "shot": {
      "type": "object", "additionalProperties": false,
      "required": ["shot_id", "shot_code", "shot_revision", "input_hash", "timeline", "actors", "environment_id", "environment_version", "expected_states"],
      "properties": {
        "shot_id": {"type": "string"}, "shot_code": {"type": "string"},
        "shot_revision": {"type": "integer", "minimum": 1}, "input_hash": {"type": "string"},
        "timeline": {"type": "object", "additionalProperties": false, "required": ["in", "out_exclusive"], "properties": {"in": {"type": "integer", "minimum": 0}, "out_exclusive": {"type": "integer", "minimum": 1}}},
        "actors": {"type": "array", "items": {"$ref": "#/$defs/actor"}},
        "environment_id": {"type": "string"}, "environment_version": {"type": "integer", "minimum": 1},
        "expected_states": {"type": "object", "additionalProperties": false, "required": ["body", "environment"], "properties": {"body": {"type": "integer", "minimum": 1}, "environment": {"type": "integer", "minimum": 1}}}
      }
    },
    "actor": {
      "type": "object", "required": ["character_id", "character_version", "actor_path", "anchor_id", "anchor_version", "anchor_path", "animation_id", "animation_version", "animation_path", "semantic_tags", "review", "retarget"],
      "properties": {
        "character_id": {"type": "string"}, "character_version": {"type": "integer", "minimum": 1}, "actor_path": {"type": "string"},
        "anchor_id": {"type": "string"}, "anchor_version": {"type": "integer", "minimum": 1}, "anchor_path": {"type": "string"},
        "animation_id": {"type": "string"}, "animation_version": {"type": "integer", "minimum": 1}, "animation_path": {"type": "string"},
        "semantic_tags": {"type": "array", "items": {"type": "string"}}, "review": {"const": "NEEDS_REVIEW"},
        "retarget": {"type": ["object", "null"]}, "paired_asset_id": {"type": "string"}, "sync_point_local_frame": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
