* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
# Keep CRLF in Git blobs too: GitHub ZIP/Raw downloads do not apply checkout EOL rules.
*.cmd -text whitespace=cr-at-eol
*.ps1 text eol=crlf
*.png binary
*.ico binary
